{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 28,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Visual Studio 17 2022",
            "architecture": "x64",
            "toolset": "host=x64"
        },
        {
            "name": "msvc-release",
            "inherits": "base",
            "displayName": "MSVC Release (single ASI)",
            "binaryDir": "${sourceDir}/build/release-msvc",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "msvc-dev",
            "inherits": "base",
            "displayName": "MSVC Dev (hot-reload two-DLL)",
            "binaryDir": "${sourceDir}/build/dev-msvc",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "EQUIPHIDE_DEV_BUILD": "ON"
            }
        },
        {
            "name": "msvc-dev-profiling",
            "inherits": "msvc-dev",
            "displayName": "MSVC Dev + DetourModKit profiler instrumentation",
            "binaryDir": "${sourceDir}/build/dev-msvc-profiling",
            "cacheVariables": {
                "DMK_ENABLE_PROFILING": "ON"
            }
        },
        {
            "name": "ninja-tidy",
            "displayName": "Ninja (compile database for clang-tidy)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/ninja-tidy",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_CXX_SCAN_FOR_MODULES": "OFF"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "msvc-release",
            "configurePreset": "msvc-release",
            "configuration": "Release"
        },
        {
            "name": "msvc-dev",
            "configurePreset": "msvc-dev",
            "configuration": "RelWithDebInfo"
        }
    ]
}
